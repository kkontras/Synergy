  "early_stopping": {
    "max_epoch": 30,
    "end_of_epoch_check": true,
    "log_interval": 10,
    "save_every_step": 500,
    "validate_every": 10,
    "save_every_valstep": 5,
    "validate_after": 0,
    "n_steps_stop": 10,
    "n_steps_stop_after": 0,
    "validate_with": "accuracy"
  },
  "dataset": {
    "dataloader_class": "ESNLI_MemmapDataloader",
    "data_roots": "/esat/smcdata/users/kkontras/Image_Dataset/no_backup/ESNLI",
    "cache_root": "/esat/smcdata/users/kkontras/Image_Dataset/no_backup/ESNLI/cache_qwen3_vl_2b_nocls_vis_tiny"
  },
  "model": {
    "save_base_dir": "/esat/smcdata/users/kkontras/Image_Dataset/no_backup/data/2025_data/synergy/ESNLI"
  }
}
