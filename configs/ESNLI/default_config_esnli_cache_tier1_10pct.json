{
  "exp_name": "ESNLI Full 10pct (MIB)",
  "agent": "Agent",
  "training_params": {
    "cuda": true,
    "gpu_device": [
      0
    ],
    "seed": 109,
    "batch_size": 8,
    "test_batch_size": 8,
    "data_loader_workers": 4,
    "pin_memory": false,
    "async_loading": true,
    "validation": true,
    "rec_test": true,
    "test_on_bottoms": false,
    "use_test_set": true,
    "verbose": true,
    "adversarial_training": {
      "use": false,
      "adv_epsilon": 0.01
    },
    "tdqm_disable": false,
    "wandb_disable": false,
    "res": true
  },
  "scheduler": {
    "type": "cosanneal",
    "max_lr": 0.001,
    "warm_up_steps": 2000
  },
  "optimizer": {
    "type": "Adaw",
    "learning_rate": 0.0001,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "beta1": 0.9,
    "beta2": 0.999
  },
  "early_stopping": {
    "max_epoch": 10,
    "end_of_epoch_check": true,
    "log_interval": 200,
    "save_every_step": 10000,
    "validate_every": 1000,
    "save_every_valstep": 1,
    "validate_after": 0,
    "n_steps_stop": 10,
    "n_steps_stop_after": 0,
    "validate_with": "accuracy"
  },
  "dataset": {
    "dataloader_class": "ESNLI_MemmapDataloader",
    "data_roots": "/dodrio/scratch/projects/2026_029/kkontras/data/ESNLI",
    "cache_root": "/dodrio/scratch/projects/2026_029/kkontras/data/ESNLI/cache_v2_full",
    "train_max_items": 40170
  },
  "model": {
    "save_base_dir": "/dodrio/scratch/projects/2026_029/kkontras/checkpoints/synergy/esnli/10pct"
  }
}