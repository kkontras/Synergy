#!/usr/bin/env bash

#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=12:gpus=1

#PBS -A 2026_029

#PBS -o ./condor_logs/logs_vsc/out_${PBS_JOBID}.txt
#PBS -e ./condor_logs/logs_vsc/err_${PBS_JOBID}.txt


cd /dodrio/scratch/projects/2026_029/kkontras/projects/Synergy

git pull origin main

source $VSC_DATA/anaconda3/etc/profile.d/conda.sh
ENV_PATH="/dodrio/scratch/projects/2026_029/kkontras/envs/synergy_new"
conda activate "${ENV_PATH}"

# Guard against broken inherited Python env vars/locales in batch shells
# unset PYTHONHOME PYTHONPATH
# export LANG=C.UTF-8
# export LC_ALL=C.UTF-8

# python -m pip install --upgrade pip setuptools wheel
# python -m pip install \
#     torch==2.9.1+cu128 \
#     torchvision==0.24.1+cu128 \
#     torchaudio==2.9.1+cu128 \
#     --index-url https://download.pytorch.org/whl/cu128
# python -m pip install --prefer-binary -r env/requirements_tier1.txt
# # Enforce known-good replacements for packages that fail wheel builds on Tier1.
# python -m pip uninstall -y ffmpeg glob2 || true
# python -m pip install --prefer-binary ffmpeg-python==0.2.0

which python
python -V
echo $PWD

DATA_ROOT="/dodrio/scratch/projects/2026_029/kkontras/data/ESNLI"
CACHE_OUT="${DATA_ROOT}/cache_v2_full"
MODEL_NAME="${model_name:-Qwen/Qwen3-VL-2B-Instruct}"
SHARD_SIZE="${shard_size:-4096}"
BUILD_BATCH="${build_batch:-8}"
HF_CACHE_ROOT="${DATA_ROOT}/hf_cache"

mkdir -p "${CACHE_OUT}" "${HF_CACHE_ROOT}" ./condor_logs/logs_vsc
export HF_HOME="${HF_CACHE_ROOT}"
export HUGGINGFACE_HUB_CACHE="${HF_CACHE_ROOT}/hub"
export HF_HUB_CACHE="${HUGGINGFACE_HUB_CACHE}"
export HF_DATASETS_CACHE="${HF_CACHE_ROOT}/datasets"
export TRANSFORMERS_CACHE="${HF_CACHE_ROOT}/transformers"
export TORCH_HOME="${HF_CACHE_ROOT}/torch"
echo "HF_HOME=${HF_HOME}"

echo "Preflight: ensuring ESNLI assets under ${DATA_ROOT}"
bash ./condor_logs/tier1/download_esnli_data.sh "${DATA_ROOT}"

for SPLIT in train validation test; do
    SPLIT_DIR="${CACHE_OUT}/${SPLIT}"
    if [ -f "${SPLIT_DIR}/manifest.jsonl" ]; then
        echo "[skip] ${SPLIT}: manifest exists"
        continue
    fi

    echo "Building ${SPLIT} ..."
    python mydatasets/ESNLI/ESNLI_CodeBook_v2.py \
        --split      "${SPLIT}"      \
        --data_root  "${DATA_ROOT}"  \
        --out_dir    "${CACHE_OUT}"  \
        --model_name "${MODEL_NAME}" \
        --shard_size "${SHARD_SIZE}" \
        --batch_size "${BUILD_BATCH}" \
        --device     "cuda:0"        \
        --dtype      fp16
    echo "Done: ${SPLIT}"
done

echo "All splits done. Cache at ${CACHE_OUT}"
