{
  "training_params": {
    "batch_size": 8,
    "test_batch_size": 8,
    "tdqm_disable": false
  },
  "early_stopping": {
    "end_of_epoch_check": true,
    "n_steps_stop": 50,
    "save_every_valstep": 10,
    "validate_every": 25
  },
  "optimizer": {
    "type": "Adam",
    "learning_rate": 0.00001,
    "momentum": 0.9,
    "weight_decay": 0.00001,
    "beta1": 0.9,
    "beta2": 0.999
  },
  "dataset": {
      "norm": false,
      "return_data" : {"video": true, "spectrogram":true, "audio":false, "face": false},
      "sampling_rate": 22050,
      "data_split": {
        "fold": 0
      }
  },
  "model": {
    "model_class": "UnimodalWrapper",
    "args": {
      "d_model": 512, "num_classes": 27, "fc_inner": 512, "in_dim": 512, "hidden_dim": 64, "dropout": 0.1,
      "cls_type": "linear",
      "clip_grad": false,
      "bias_infusion": {
        "method": "false",
        "l": 0.1,
        "starting_epoch": 0,
        "ending_epoch": 1500,
        "use": true,
        "plot": false
      },
      "lora": {
        "use": false,
        "encoder_type": "text",
        "r": 16,
        "alpha": 32,
        "dropout": 0.05,
        "target_modules": ["q_lin", "k_lin", "v_lin", "out_lin"],
        "bias": "none",
        "freeze_head": false
      },
      "multi_loss": {
        "multi_supervised_w": {
             "combined": 1
          }
      }
    },
    "load_ongoing": false,
    "save_dir": "Unimodal_Text_{}.pth.tar",
    "save_base_dir": "/esat/smcdata/users/kkontras/Image_Dataset/no_backup/data/2025_data/synergy/Rmask/MMIMDB",
    "encoders": [
      {
        "model": "Text_DistilBERT",
        "args": {
          "hf_cache": "/esat/smcdata/users/kkontras/Image_Dataset/no_backup/data/2025_data/synergy/Rmask/MMIMDB",
          "d_model": 512,
          "num_classes": 80,
          "fc_inner": 64,
          "in_dim": 64,
          "dropout": 0.1,
          "freeze_encoder": false
        },
        "pretrainedEncoder": {
          "use": false,
          "dir": ""
        }
      }
    ]
  }
}