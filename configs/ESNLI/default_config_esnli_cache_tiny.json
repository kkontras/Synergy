{
  "exp_name": "ESNLI Tiny Smoke",
  "agent": "Agent",
  "training_params": {
    "cuda": true,
    "gpu_device": [0],
    "seed": 109,
    "batch_size": 8,
    "test_batch_size": 8,
    "data_loader_workers": 0,
    "pin_memory": false,
    "async_loading": false,
    "validation": true,
    "rec_test": true,
    "test_on_bottoms": false,
    "use_test_set": true,
    "verbose": true,
    "adversarial_training": {
      "use": false,
      "adv_epsilon": 0.01
    },
    "tdqm_disable": true,
    "wandb_disable": true,
    "res": true
  },
  "scheduler": {
    "type": "cosanneal",
    "max_lr": 0.03,
    "warm_up_steps": 100
