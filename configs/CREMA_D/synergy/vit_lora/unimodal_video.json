{
  "training_params": {
    "seed": 109,
    "batch_size": 2,
    "tdqm_disable": false
  },
  "scheduler": { "type": "cosanneal", "max_lr": 0.001, "warm_up_steps": 1500 },
  "optimizer": {
    "type": "Adam",
    "learning_rate": 0.00001,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "beta1": 0.95,
    "beta2": 0.999
  },
  "dataset": {
    "norm_wav_path": "./mydatasets/CREMAD/wav_norm_16000_v2_fold{}.pkl",
    "norm_face_path": "./mydatasets/CREMAD/norm_face_path_v2_fold{}.pkl",
    "return_data": { "video": true, "spectrogram": false, "audio": false, "face": false },
    "sampling_rate": 16000,
    "num_frame": 3,
    "data_split": { "fold": 0 }
  },
  "model": {
    "model_class": "Video_ViViT_LoRA_Pool",
    "args": {
      "d_model": 512,
      "num_classes": 6,
      "fc_inner": 64,
      "dropout": 0.1,
      "num_frame": 3,
      "pretrained_encoder": true,
      "lora_config": {
        "use_lora": true,
        "lora_r": 8,
        "lora_alpha": 16,
        "lora_dropout": 0.05,
        "lora_target_modules": ["query", "value"]
      },
      "bias_infusion": { "method": false },
      "multi_loss": {
        "multi_supervised_w": { "combined": 1 }
      }
    },
    "load_ongoing": false,
    "save_dir": "unimodal_video_lora_{}.pth.tar"
  }
}
